# Copy to .env and fill in by hand -- never commit the real .env.

# Shared secret the source Job Radar instance authenticates its pushes
# with. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
HUB_PUSH_TOKEN=

# Optional -- defaults shown.
# HUB_DB_PATH=db/hub.db
# PORT=5300
# MCP_PORT=5301

# Required for the MCP server once it's reachable from anywhere but
# localhost -- the SDK's DNS-rebinding protection rejects any other Host
# header with a 421 otherwise. Comma-separated, e.g. your VM's IP:port
# and/or a real domain once one points here.
MCP_ALLOWED_HOSTS=

# Email alerts (see README.md's "Email alerts" section). Get a key at
# resend.com -- the free tier is plenty to start. Leave unset and alert
# emails are just skipped (logged, not sent) rather than erroring.
RESEND_API_KEY=

# Optional -- defaults shown. onboarding@resend.dev works with no domain
# verification at all, but only ever delivers to your own Resend account
# email -- fine for testing, not for real subscribers. Swap once you've
# verified a domain with Resend.
# ALERTS_FROM_EMAIL=onboarding@resend.dev

# Optional -- the base URL used to build confirm/unsubscribe links in
# alert emails. Defaults to the incoming request's own host, which is
# correct as long as nothing proxies requests to this app under a
# different host/port than what it's actually reachable at. Set explicitly
# once a real domain points here, e.g. https://hub.example.com
# HUB_PUBLIC_BASE_URL=
