[Unit]
Description=Job Radar Hub (public listings API)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/job-radar-hub
# -w 1: Flask-Limiter's rate limiting is in-memory per-process -- multiple
# workers would each keep their own counter, silently multiplying every
# consumer's effective rate limit. Fine at this traffic scale; revisit with
# a shared store (e.g. Redis) if this ever needs more than one worker.
# 127.0.0.1:8000, not a public port -- nginx (see /etc/nginx/sites-available/
# job-radar) is now the single public entry point on :80, routing by Host
# header to this Hub (hub.12getajob.com) or the MCP server
# (mcp.12getajob.com) -- needed once there were two separate services both
# wanting Cloudflare Flexible SSL's fixed "always talks to the origin on
# port 80" behavior; only one process can bind that port, so nginx fronts
# both instead. See job-radar-hub-mcp.service for the same story on that
# side.
ExecStart=/opt/job-radar-hub/venv/bin/gunicorn -w 1 -b 127.0.0.1:8000 app:app
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
